#!/usr/bin/env bash
#
# nexus-cli —— Nexus Repository Manager 的 CLI 主入口。
#
# 设计原则：本脚本只做「参数整形」，不自己实现 HTTP/认证。
#   * 通用命令全部透传给 Restish（restish nexus-cli ...），复用其 profile/auth/输出/重试。
#   * 只有 Restish 做不好的几件事由本脚本处理：
#       1) upload / upload-dir —— Restish shorthand 会把 multipart 字段名 maven2.asset1
#          改写成 maven2[asset1] 并丢弃二进制部分，Nexus 要求字面量点号字段名，
#          所以这里用 curl 发送（凭据仍由 restish 提供）。
#       2) task wait   —— 轮询异步任务到终态。
#       3) login/whoami/mcp —— 凭据文件管理与 MCP 入口（让 MCP 也读到凭据文件）。
#
# 用法: nexus-cli --help
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
# 绝对化：batch worker 会通过 xargs 重新调用本脚本，相对路径/PATH 都可能出问题
case "$SELF" in
  */*) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")";;
  *)   SELF="$(command -v "$SELF" || printf '%s' "$SELF")";;
esac
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
API="nexus-cli"
# 注意：这里【故意不设置】RSH_CONFIG。Restish 一旦被显式指定配置就会禁用插件加载，
# 而 MCP（restish mcp）本身是插件。API 定义由 scripts/install.sh 装进全局配置。
# 需要临时切配置时，外部导出 RSH_CONFIG 即可，本脚本不会覆盖它。
: "${RSH_CACHE_DIR:=$ROOT/.cache}"
export RSH_CACHE_DIR

# ── 凭据 ───────────────────────────────────────────────────────────────────
# 优先级：环境变量 > 凭据文件。
# 文件由 `nexus-cli login` 写入（chmod 600）。文件只「填补」环境里没有的变量，
# 不会覆盖你显式导出的值 —— 这样 CI/agent 用环境变量、日常用文件，互不打架。
CRED_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/nexus-cli/env"
CRED_SOURCE="未设置"

load_creds() {
  local k v line
  if [ -n "${NEXUS_USER:-}" ] || [ -n "${NEXUS_PASSWORD:-}" ]; then
    CRED_SOURCE="环境变量"
  fi
  if [ -f "$CRED_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) continue;; esac
      k="${line%%=*}"
      v="${line#*=}"
      case "$k" in
        NEXUS_USER|NEXUS_PASSWORD|NEXUS_ADMIN_USER|NEXUS_ADMIN_PASSWORD) ;;
        *) continue;;
      esac
      # 环境变量优先：文件只填补未设置的
      if [ -z "${!k:-}" ]; then
        export "$k=$v"
        if [ "$k" = "NEXUS_USER" ] && [ "$CRED_SOURCE" = "未设置" ]; then
          CRED_SOURCE="文件 $CRED_FILE"
        fi
      fi
    done < "$CRED_FILE"
  fi
  # 必须显式 return 0：while 循环以「条件测试失败（EOF）」收尾，
  # 会把函数的退出状态留成 1，被外面的 set -e 当成失败终止整个脚本。
  return 0
}
load_creds

die()  { printf 'nexus-cli: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "缺少依赖: $1"; }
warn() { printf 'nexus-cli: %s\n' "$*" >&2; }

# vendor spec 的路径：以 Restish 配置里的 spec_files[0] 为准（install.sh 会写成绝对路径），
# 取不到再回退到仓库内版本号最高的 spec/nexus-*.json。
# 不要在代码里硬编码版本号 —— sync-spec.sh 升级时会改文件名。
resolve_spec() {
  local p
  p="$(restish config show -o json 2>/dev/null \
        | jq -r --arg a "$API" '.apis[$a].spec_files[0] // empty' 2>/dev/null || true)"
  case "$p" in
    ./*) p="$ROOT/${p#./}";;
  esac
  if [ -z "$p" ] || [ ! -f "$p" ]; then
    p="$(ls -1 "$ROOT"/spec/nexus-*.json 2>/dev/null | sort -V | tail -1 || true)"
  fi
  [ -n "$p" ] && [ -f "$p" ] || die "找不到 vendor spec（先跑 scripts/install.sh）"
  printf '%s' "$p"
}

# 从 Restish 配置读 base_url，从 spec 读 API 根路径（保持单一事实来源）
resolve_url() {
  local base api_base
  base="$(restish config show -o json 2>/dev/null | jq -r --arg a "$API" '.apis[$a].base_url // empty')"
  [ -n "$base" ] || die "无法从 Restish 配置读取 base_url（RSH_CONFIG=${RSH_CONFIG:-<未设置>}）"
  api_base="$(jq -r '.servers[0].url // "/service/rest"' "$(resolve_spec)")"
  printf '%s' "${base%/}${api_base}"
}

# 取认证头。注意：这里必须用 return 而不是 die/exit ——
# 函数在 $( ) 命令替换里执行时，exit 会直接终止子 shell 并绕过调用处的 `|| true`，
# 导致赋值返回非零再被 set -e 静默杀掉（dry-run 就会没有任何输出）。
auth_header() {
  local h
  h="$(restish api auth get "$API" 2>/dev/null)" || {
    printf 'nexus-cli: %s\n' \
      '无法取得认证信息：请设置 NEXUS_USER / NEXUS_PASSWORD（或先运行 nexus-cli login）' >&2
    return 1
  }
  printf '%s' "$h"
}

# ── HTTP ───────────────────────────────────────────────────────────────────
# 发送一次 components POST。$1=repo，其余参数为字段规格（key=value，@file 表示文件）。
# 失败时把响应体打到 stderr，返回 1。
post_component() {
  local repo="$1"; shift
  local -a F=("$@")
  local url auth tmp code e
  url="$(resolve_url)/v1/components?repository=$repo"
  auth="$(auth_header)" || return 1

  tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN
  # 注意：必须把 -F 和值作为「两个独立参数」传给 curl。
  # 形如 "-F key=value" 的单参数会让 curl 把空格算进字段名（name=" key"）。
  local -a CARGS=()
  for e in "${F[@]}"; do CARGS+=(-F "$e"); done

  code="$(curl -sS -m 300 -o "$tmp" -w '%{http_code}' -X POST "$url" -H "$auth" \
            "${CARGS[@]}")" || { printf '网络错误\n' >&2; return 1; }

  case "$code" in
    200|201|204) return 0;;
    *) printf 'HTTP %s: %s\n' "$code" "$(head -c 300 "$tmp" | tr -d '\n')" >&2; return 1;;
  esac
}

# ── 帮助 ────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
nexus-cli —— Nexus Repository Manager CLI（基座: Restish）

用法:
  nexus-cli <group> <command> [args]   通用命令，透传给 restish nexus-cli
  nexus-cli upload ...                 上传单个构件（multipart，Restish 无法表达）
  nexus-cli upload-dir ...             批量上传一个目录
  nexus-cli task wait <id>             轮询异步任务直到终态（0=成功 1=失败 124=超时）
  nexus-cli login ...                  创建/写入 user token 到凭据文件
  nexus-cli whoami                     显示当前生效的凭据来源
  nexus-cli mcp                        以 MCP server 方式启动（供 AI agent 接入）
  nexus-cli groups                     列出命令分组
  nexus-cli --help-all                 查看 Restish 全部选项

常用:
  nexus-cli repo list -o json
  nexus-cli repo get <name> -o json
  nexus-cli component list --repository <repo> -o json
  nexus-cli asset list --repository <repo> -o json
  nexus-cli search query --maven-groupId com.example -o json
  nexus-cli blobstore list -o json
  nexus-cli task list -o json
  nexus-cli status show -o json

单文件上传:
  nexus-cli upload --repo <repo> --format maven --file app.jar \\
      --group com.example --artifact app --version 1.0.0 [--packaging jar] [--classifier src] [--extension jar]
  nexus-cli upload --repo <repo> --format raw --file notes.txt --directory /docs [--filename notes.txt]
  nexus-cli upload --repo <repo> --format npm|pypi|nuget|helm|rubygems|r|apt --file pkg.ext
  nexus-cli upload --repo <repo> --format yum --file pkg.rpm --directory /x86_64
  nexus-cli upload --repo <repo> --format go --file mod.zip --version v1.2.3
  nexus-cli upload --repo <repo> --format conda --file pkg.tar.bz2 --filename pkg.tar.bz2
  nexus-cli upload --repo <repo> --format composer --file pkg.zip --version 1.0.0
  nexus-cli upload --repo <repo> --format <fmt> --file f --field 'k=v' --field 'k2=v2'   # 任意字段兜底
  nexus-cli upload ... --dry-run        # 只打印将执行的 curl，不发送

批量目录上传:
  # 保留目录结构 → raw 仓库（相对路径变成 raw.directory）
  nexus-cli upload-dir --repo <raw-repo> --dir ./dist [--prefix /release/1.0]

  # 按 Maven 仓库布局推断坐标 → maven 仓库
  # 目录形如 <group 路径>/<artifactId>/<version>/<文件>，例如：
  #   ./m2/com/example/app/1.0.0/app-1.0.0.jar
  nexus-cli upload-dir --repo <maven-repo> --format maven --dir ./m2

  公共选项: [--include '*.jar'] [--exclude '*-sources.jar'] [--jobs 4] [--dry-run]

提示:
  * 所有输出建议加 -o json（agent/脚本），人看可省。
  * 破坏性命令（delete 等）在 CLI 仍可用，但对 MCP 已屏蔽。
EOF
}

# ── upload ─────────────────────────────────────────────────────────────────
upload_help() { sed -n '/^单文件上传:/,/^批量目录上传:/p' <<<"$(usage)"; }

# 把 --format 翻译成 Nexus 的 multipart 字段名。
# $1=format, $2=file；其余通过位置变量传入（见 cmd_upload）。
build_fields() {
  local format="$1" file="$2"
  local group="$3" artifact="$4" version="$5" packaging="$6" classifier="$7" extension="$8"
  local directory="$9" filename="${10}"
  FIELDS=()
  case "$format" in
    maven|maven2)
      [ -n "$group" ]    || die "maven 需要 --group"
      [ -n "$artifact" ] || die "maven 需要 --artifact"
      [ -n "$version" ]  || die "maven 需要 --version"
      FIELDS+=("maven2.groupId=$group" "maven2.artifactId=$artifact"
               "maven2.version=$version" "maven2.packaging=$packaging"
               "maven2.asset1=@$file")
      [ -n "$extension" ]  && FIELDS+=("maven2.asset1.extension=$extension")
      [ -n "$classifier" ] && FIELDS+=("maven2.asset1.classifier=$classifier")
      ;;
    raw)
      FIELDS+=("raw.asset1=@$file" "raw.asset1.filename=$filename")
      [ -n "$directory" ] && FIELDS+=("raw.directory=$directory")
      ;;
    yum)
      FIELDS+=("yum.asset=@$file" "yum.asset.filename=$filename")
      [ -n "$directory" ] && FIELDS+=("yum.directory=$directory")
      ;;
    go)
      [ -n "$version" ] || die "go 需要 --version"
      FIELDS+=("go.asset=@$file" "go.version=$version")
      ;;
    conda)
      FIELDS+=("conda.asset=@$file" "conda.filename=$filename")
      [ -n "$version" ] && FIELDS+=("conda.version=$version")
      ;;
    composer)
      FIELDS+=("composer.asset=@$file")
      [ -n "$version" ] && FIELDS+=("composer.version=$version")
      ;;
    npm|pypi|nuget|helm|rubygems|r|apt)
      FIELDS+=("$format.asset=@$file")
      ;;
    docker|oci|huggingface)
      die "'$format' 不走 REST 上传，请用 docker/helm push 等原生客户端"
      ;;
    *)
      die "不支持的 --format '$format'（可用 --field k=v 指定任意字段名）"
      ;;
  esac
  # 必须显式 return 0：上面若干分支以 `[ -n x ] && ...` 结尾，
  # 条件为假时会把函数退出状态留成 1，被外面的 set -e 当成失败。
  return 0
}

cmd_upload() {
  local repo="" format="" file="" directory="" filename=""
  local group="" artifact="" version="" packaging="jar" classifier="" extension=""
  local dry_run=0
  local -a extra=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)        repo="${2:?}"; shift 2;;
      --format)      format="${2:?}"; shift 2;;
      --file)        file="${2:?}"; shift 2;;
      --directory)   directory="${2:?}"; shift 2;;
      --filename)    filename="${2:?}"; shift 2;;
      --group|--groupId)       group="${2:?}"; shift 2;;
      --artifact|--artifactId) artifact="${2:?}"; shift 2;;
      --version)     version="${2:?}"; shift 2;;
      --packaging)   packaging="${2:?}"; shift 2;;
      --classifier)  classifier="${2:?}"; shift 2;;
      --extension)   extension="${2:?}"; shift 2;;
      --field)       extra+=("${2:?}"); shift 2;;
      --dry-run)     dry_run=1; shift;;
      -h|--help)     upload_help; return 0;;
      *) die "upload: 未知参数 '$1'（用 --field k=v 传任意字段）";;
    esac
  done

  [ -n "$repo" ]   || die "upload: 需要 --repo"
  [ -n "$format" ] || die "upload: 需要 --format"
  [ -n "$file" ]   || die "upload: 需要 --file"
  [ -f "$file" ]   || die "upload: 文件不存在: $file"
  need curl; need jq

  if [ -z "$extension" ]; then
    extension="${file##*.}"
    [ "$extension" = "$file" ] && extension=""
  fi
  [ -n "$filename" ] || filename="$(basename "$file")"

  local -a FIELDS=()
  build_fields "$format" "$file" "$group" "$artifact" "$version" "$packaging" \
               "$classifier" "$extension" "$directory" "$filename"
  local e
  for e in "${extra[@]:-}"; do [ -n "$e" ] && FIELDS+=("$e"); done

  if [ "$dry_run" -eq 1 ]; then
    printf 'curl -X POST %q \\\n  -H %q' \
      "$(resolve_url)/v1/components?repository=$repo" \
      "<由 restish api auth get $API 生成>"
    printf ' \\\n  -F %q' "${FIELDS[@]}"
    printf '\n'
    return 0
  fi

  if post_component "$repo" "${FIELDS[@]}"; then
    printf '上传成功: %s\n' "$(basename "$file")"
  else
    die "上传失败: $(basename "$file")"
  fi
}

# ── upload-dir ─────────────────────────────────────────────────────────────
upload_dir_help() { sed -n '/^批量目录上传:/,/^提示:/p' <<<"$(usage)"; }

# 过滤规则（枚举阶段和 worker 阶段共用 —— worker 会重新扫目录，
# 如果只在枚举阶段过滤，maven 的同目录文件会绕过去）
# $1=basename $2=include $3=exclude $4=format；符合则返回 0
should_include() {
  local name="$1" include="$2" exclude="$3" fmt="$4"
  case "$name" in .DS_Store|.gitignore) return 1;; esac
  if [ "$fmt" = "maven" ] || [ "$fmt" = "maven2" ]; then
    # Nexus 自己维护的元数据默认跳过（要传就显式 --include 覆盖）
    if [ -z "$include" ]; then
      case "$name" in maven-metadata*.xml) return 1;; esac
    fi
  fi
  if [ -n "$include" ]; then
    case "$name" in $include) ;; *) return 1;; esac
  fi
  if [ -n "$exclude" ]; then
    case "$name" in $exclude) return 1;; esac
  fi
  return 0
}

# 枚举任务，NUL 分隔写入 $1，并回显任务数。
#   raw   → 每个文件一个任务（任务 = 文件路径）
#   maven → 每个 <...>/<artifactId>/<version>/ 目录一个任务（任务 = 目录路径）
enumerate_jobs() {
  local out="$1" format="$2" base="$3" include="$4" exclude="$5"
  local -a findargs=("$base" -type f -not -path '*/.git/*' -not -path '*/.svn/*')
  local -a list=()
  local f rel name

  while IFS= read -r -d '' f; do
    rel="${f#"$base"/}"
    name="$(basename "$f")"
    should_include "$name" "$include" "$exclude" "$format" || continue

    case "$format" in
      maven|maven2) list+=("$(dirname "$f")");;
      *)            list+=("$f");;
    esac
  done < <(find "${findargs[@]}" -print0 2>/dev/null | sort -z)

  : > "$out"
  local p
  if [ "${#list[@]}" -gt 0 ]; then
    # 去重后写入
    printf '%s\0' "${list[@]}" | tr '\0' '\n' | LC_ALL=C sort -u | tr '\n' '\0' >> "$out"
  fi
  tr -cd '\0' < "$out" | wc -c | tr -d ' '
}

# 供批量上传并行调用的 worker（不要直接使用）。
# 参数由 NEXUS_UD_* 环境变量传入。
cmd_upload_one() {
  local target="${1:-}"
  [ -n "$target" ] || die "_upload_one: 缺少路径"
  local repo="${NEXUS_UD_REPO:?}" format="${NEXUS_UD_FORMAT:?}"
  local base="${NEXUS_UD_BASE:?}" prefix="${NEXUS_UD_PREFIX:-}"
  local dry="${NEXUS_UD_DRY:-0}"
  local ud_include="${NEXUS_UD_INCLUDE:-}" ud_exclude="${NEXUS_UD_EXCLUDE:-}"
  local -a F=()
  local rel dirpart f name

  case "$format" in
    maven|maven2)
      # target 是 <...>/<artifactId>/<version> 目录
      rel="${target#"$base"/}"
      local version="${rel##*/}"
      local rest="${rel%/*}"
      local artifact="${rest##*/}"
      local grouppath=""
      [ "$rest" != "${rest%/*}" ] && grouppath="${rest%/*}"
      local groupid="${grouppath//\//.}"

      # 排序：主件 → pom → 带 classifier（sources/javadoc…）→ 其它
      # 这样 3 个一组时通常正好是 asset1=主件, asset2=pom, asset3=sources
      local pre="${artifact}-${version}"
      local -a primf=() pomf=() classf=() otherf=() files=()
      while IFS= read -r -d '' f; do
        name="$(basename "$f")"
        should_include "$name" "$ud_include" "$ud_exclude" "$format" || continue
        local stem="${name%.*}"; [ "$stem" = "$name" ] && stem="$name"
        local ext="${name##*.}"; [ "$ext" = "$name" ] && ext=""
        if [ "$stem" = "$pre" ]; then
          if [ "$ext" = "pom" ]; then pomf+=("$f"); else primf+=("$f"); fi
        elif [ "${stem#"$pre"}" != "$stem" ]; then
          classf+=("$f")
        else
          otherf+=("$f")
        fi
      done < <(find "$target" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
      [ "${#primf[@]}"  -gt 0 ] && files+=("${primf[@]}")
      [ "${#pomf[@]}"   -gt 0 ] && files+=("${pomf[@]}")
      [ "${#classf[@]}" -gt 0 ] && files+=("${classf[@]}")
      [ "${#otherf[@]}" -gt 0 ] && files+=("${otherf[@]}")

      if [ "${#files[@]}" -eq 0 ]; then
        printf 'OK\t%s:%s:%s\t(空目录，跳过)\n' "$groupid" "$artifact" "$version"
        return 0
      fi

      local i j f2 n ext stem cls
      for ((i=0; i<${#files[@]}; i+=3)); do
        local -a F=("maven2.groupId=$groupid" "maven2.artifactId=$artifact"
                    "maven2.version=$version" "maven2.packaging=jar")
        n=0
        for ((j=i; j<i+3 && j<${#files[@]}; j++)); do
          n=$((n+1))
          f2="${files[$j]}"; name="$(basename "$f2")"
          stem="${name%.*}"; [ "$stem" = "$name" ] && stem="$name"
          ext="${name##*.}"; [ "$ext" = "$name" ] && ext=""
          cls=""
          if [ "$stem" != "$pre" ] && [ "${stem#"$pre"}" != "$stem" ]; then
            cls="${stem#"$pre"}"; cls="${cls#-}"
          fi
          F+=("maven2.asset${n}=@$f2" "maven2.asset${n}.extension=$ext")
          [ -n "$cls" ] && F+=("maven2.asset${n}.classifier=$cls")
        done

        if [ "$dry" -eq 1 ]; then
          printf 'PLAN\t%s:%s:%s\t%s\n' "$groupid" "$artifact" "$version" "${F[*]}"
        elif post_component "$repo" "${F[@]}"; then
          printf 'OK\t%s:%s:%s\n' "$groupid" "$artifact" "$version"
        else
          printf 'FAIL\t%s:%s:%s\n' "$groupid" "$artifact" "$version"
        fi
      done
      ;;

    *)
      # raw：保留目录结构
      name="$(basename "$target")"
      rel="${target#"$base"/}"
      should_include "$name" "$ud_include" "$ud_exclude" "$format" \
        || { printf 'SKIP\t%s\n' "$rel"; return 0; }
      dirpart="$(dirname "$rel")"
      [ "$dirpart" = "." ] && dirpart=""
      local full
      full="${prefix%/}"
      [ -n "$dirpart" ] && full="${full}/${dirpart}"
      full="${full#/}"

      F=("raw.asset1=@$target" "raw.asset1.filename=$name")
      [ -n "$full" ] && F+=("raw.directory=/$full")

      if [ "$dry" -eq 1 ]; then
        printf 'PLAN\t%s\t%s\n' "$rel" "${F[*]}"
      elif post_component "$repo" "${F[@]}"; then
        printf 'OK\t%s\n' "$rel"
      else
        printf 'FAIL\t%s\n' "$rel"
      fi
      ;;
  esac
  return 0
}

cmd_upload_dir() {
  local repo="" format="raw" dir="" prefix="" include="" exclude="" jobs=4 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)     repo="${2:?}"; shift 2;;
      --format)   format="${2:?}"; shift 2;;
      --dir)      dir="${2:?}"; shift 2;;
      --prefix)   prefix="${2:?}"; shift 2;;
      --include)  include="${2:?}"; shift 2;;
      --exclude)  exclude="${2:?}"; shift 2;;
      --jobs)     jobs="${2:?}"; shift 2;;
      --dry-run)  dry=1; shift;;
      -h|--help)  upload_dir_help; return 0;;
      *) die "upload-dir: 未知参数 '$1'";;
    esac
  done

  [ -n "$repo" ] || die "upload-dir: 需要 --repo"
  [ -n "$dir" ]  || die "upload-dir: 需要 --dir"
  [ -d "$dir" ]  || die "upload-dir: 目录不存在: $dir"
  case "$format" in
    raw|maven|maven2) ;;
    *) die "upload-dir: --format 目前支持 raw | maven（其它格式请用 upload 逐文件传）";;
  esac
  case "$jobs" in ''|*[!0-9]*) die "upload-dir: --jobs 需为正整数";; esac
  [ "$jobs" -ge 1 ] || die "upload-dir: --jobs 需 >= 1"
  need curl; need jq

  dir="${dir%/}"
  local absdir; absdir="$(cd "$dir" && pwd)"

  local joblist count
  joblist="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$joblist'" RETURN
  count="$(enumerate_jobs "$joblist" "$format" "$absdir" "$include" "$exclude")"
  [ "$count" -gt 0 ] || die "没有匹配到文件（检查 --dir / --include / --exclude）"

  printf '仓库=%s  格式=%s  任务=%s  并发=%s%s\n' \
    "$repo" "$format" "$count" "$jobs" "$([ "$dry" -eq 1 ] && echo '  [dry-run]')" >&2

  local tmp; tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$joblist' '$tmp'" RETURN

  xargs -0 -P "$jobs" -n1 env \
    NEXUS_UD_REPO="$repo" NEXUS_UD_FORMAT="$format" NEXUS_UD_BASE="$absdir" \
    NEXUS_UD_PREFIX="$prefix" NEXUS_UD_DRY="$dry" \
    NEXUS_UD_INCLUDE="$include" NEXUS_UD_EXCLUDE="$exclude" \
    "$SELF" _upload_one < "$joblist" > "$tmp" || true

  if [ "$dry" -eq 1 ]; then
    printf -- '--- 计划发送的请求（%s 个目标）---\n' "$count"
    cat "$tmp"
    return 0
  fi

  local ok fail skp
  ok="$(grep -c '^OK' "$tmp" || true)"
  fail="$(grep -c '^FAIL' "$tmp" || true)"
  skp="$(grep -c '^SKIP' "$tmp" || true)"
  ok="${ok:-0}"; fail="${fail:-0}"; skp="${skp:-0}"

  if [ "$fail" -gt 0 ]; then
    printf '\n失败清单:\n'
    grep '^FAIL' "$tmp" | sed 's/^FAIL\t/  - /'
  fi
  printf '\n汇总: 成功 %s / 失败 %s%s\n' "$ok" "$fail" \
    "$([ "$skp" -gt 0 ] && printf ' / 跳过 %s' "$skp")"
  [ "$fail" -eq 0 ] || exit 1
}

# ── task wait ──────────────────────────────────────────────────────────────
cmd_task_wait() {
  local id="${1:-}"
  case "$id" in
    -h|--help)
      echo "用法: nexus-cli task wait <taskId> [--timeout 秒] [--interval 秒]"
      echo "轮询任务到终态：0=成功 1=失败 124=超时"
      return 0;;
    "") die "用法: nexus-cli task wait <taskId> [--timeout 秒] [--interval 秒]";;
  esac
  shift || true
  local timeout=300 interval=3
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)  timeout="${2:?}"; shift 2;;
      --interval) interval="${2:?}"; shift 2;;
      *) die "task wait: 未知参数 '$1'";;
    esac
  done
  need jq

  local deadline=$(( $(date +%s) + timeout ))
  local seen_running=0 json state result
  while :; do
    json="$(restish "$API" task get "$id" -o json 2>/dev/null)" || die "读取任务 $id 失败"
    state="$(jq -r '.currentState // "UNKNOWN"' <<<"$json")"
    result="$(jq -r '.lastRunResult // ""' <<<"$json")"

    case "$state" in
      RUNNING|BLOCKED)  seen_running=1;;
      COMPLETED)        printf '任务 %s 完成：%s\n' "$id" "$state"
                        if [ -z "$result" ] || [ "$result" = "OK" ]; then return 0; else return 1; fi;;
      FAILED|CANCELLED) printf 'nexus-cli: 任务 %s 未成功：%s (%s)\n' "$id" "$state" "$result" >&2
                        return 1;;
      WAITING|PENDING)
        # 任务定义在空闲时也是 WAITING；只有「见过 RUNNING 之后回到空闲」才算跑完
        if [ "$seen_running" -eq 1 ]; then
          if [ "$result" = "OK" ] || [ -z "$result" ]; then
            printf '任务 %s 已执行完成（lastRunResult=%s）\n' "$id" "${result:-<空>}"
            return 0
          fi
          printf 'nexus-cli: 任务 %s 已执行但结果为 %s\n' "$id" "$result" >&2
          return 1
        fi
        ;;
      *) ;;
    esac

    if [ "$(date +%s)" -ge "$deadline" ]; then
      printf 'nexus-cli: 等待任务 %s 超时（%ss），当前状态 %s\n' "$id" "$timeout" "$state" >&2
      return 124
    fi
    sleep "$interval"
  done
}

# ── login / whoami ─────────────────────────────────────────────────────────
cmd_login() {
  local user="" admin_user="${NEXUS_ADMIN_USER:-}" admin_pass="${NEXUS_ADMIN_PASSWORD:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --user)       user="${2:?}"; shift 2;;
      --admin-user) admin_user="${2:?}"; shift 2;;
      --admin-pass) admin_pass="${2:?}"; shift 2;;
      -h|--help)    echo "用法: nexus-cli login --user <要为其创建token的用户> [--admin-user U] [--admin-pass P]"; return 0;;
      *) die "login: 未知参数 '$1'";;
    esac
  done
  [ -n "$user" ] || die "login: 需要 --user（目标用户，通常是只读账号）"
  [ -n "$admin_user" ] || die "login: 需要 --admin-user（或环境变量 NEXUS_ADMIN_USER）"
  [ -n "$admin_pass" ] || die "login: 需要 --admin-pass（或环境变量 NEXUS_ADMIN_PASSWORD）"
  need curl; need jq

  local api_base resp name passcode
  api_base="$(resolve_url)"
  resp="$(curl -sS -m 30 -u "$admin_user:$admin_pass" -X POST \
            "$api_base/v1/security/users/$user/token")" \
    || die "调用 token 接口失败"

  name="$(jq -r '.name // empty' <<<"$resp")"
  passcode="$(jq -r '.passcode // empty' <<<"$resp")"
  [ -n "$name" ] && [ -n "$passcode" ] || die "token 响应异常: $resp"

  mkdir -p "$(dirname "$CRED_FILE")"
  umask 077
  cat > "$CRED_FILE" <<EOF
# 由 \`nexus-cli login\` 生成。Nexus user token（可吊销），勿提交、勿外泄。
NEXUS_USER=$name
NEXUS_PASSWORD=$passcode
EOF
  chmod 600 "$CRED_FILE"
  printf '已写入 %s（chmod 600）\n用户: %s\n' "$CRED_FILE" "$user"
  printf '提示: token 与用户绑定且可吊销；吊销请用 DELETE %s/v1/security/users/%s/token\n' "$api_base" "$user"
}

cmd_whoami() {
  local check=0
  [ "${1:-}" = "--check" ] && check=1
  printf '凭据来源: %s\n' "$CRED_SOURCE"
  printf '凭据文件: %s%s\n' "$CRED_FILE" "$([ -f "$CRED_FILE" ] && echo "" || echo "（不存在）")"
  if [ -n "${NEXUS_USER:-}" ]; then
    printf 'NEXUS_USER: %s\n' "$(printf '%s' "${NEXUS_USER}" | sed 's/\(.\{4\}\).*/\1…/')"
  else
    printf 'NEXUS_USER: <未设置>\n'
  fi
  if [ -n "${NEXUS_PASSWORD:-}" ]; then
    printf 'NEXUS_PASSWORD: 已设置（%s 字符）\n' "${#NEXUS_PASSWORD}"
  else
    printf 'NEXUS_PASSWORD: <未设置>\n'
  fi
  local base; base="$(restish config show -o json 2>/dev/null \
    | jq -r --arg a "$API" '.apis[$a].base_url // "?"')"
  printf '目标: %s\n' "$base"

  if [ "$check" -eq 1 ]; then
    if restish --rsh-retry 0 "$API" status show -o json >/dev/null 2>&1; then
      printf '连通性: OK\n'
    else
      printf '连通性: 失败（凭据无效/受限？）\n' >&2
      return 1
    fi
  fi
}

# ── 分发 ───────────────────────────────────────────────────────────────────
need restish

# API 必须已注册（由 scripts/install.sh 写入 Restish 全局配置）
if ! restish api list 2>/dev/null | grep -q "^$API[[:space:]]"; then
  die "API '$API' 未注册。请先运行: $ROOT/scripts/install.sh"
fi

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  "")            usage; exit 0;;
  -h|--help)     usage; exit 0;;
  groups)        restish "$API" --help;;
  upload)        cmd_upload "$@";;
  upload-dir)    cmd_upload_dir "$@";;
  _upload_one)   cmd_upload_one "$@";;
  login)         cmd_login "$@";;
  whoami)        cmd_whoami "$@";;
  mcp)
    # 走本脚本启动 MCP，这样客户端直接拉起时也能读到凭据文件
    # （否则 restish mcp serve 不会经过上面的 load_creds）。
    exec restish mcp serve "$API" "$@"
    ;;
  task)
    sub="${1:-}"
    case "$sub" in
      wait) [ $# -gt 0 ] && shift; cmd_task_wait "$@";;
      *)    exec restish "$API" task "$sub" "$@";;
    esac
    ;;
  *)
    # 其余全部透传：repo list / component upload-unsupported / search query / ...
    exec restish "$API" "$cmd" "$@"
    ;;
esac
